# Copy this file to .env and fill in the values.

# Gemini (Google AI Studio → API keys). Without a key the app uses its built-in demo analyser.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash

# Supabase (Project Settings → API). Without these, data is stored only on this device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
